{
  "name": "smartbuy-ai-fashion-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SMARTBUY AI FASHION - Monorepo (Frontend, Backend, Database, AI Server)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:fe": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:be": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:ai": "cmd /c \"cd ai-server && start_server.bat\"",
    "build": "npm --prefix frontend run build",
    "build:fe": "npm --prefix frontend run build",
    "build:be": "npm --prefix backend run build",
    "lint": "npm --prefix frontend run lint",
    "test:variants": "node scripts/test-variants.cjs"
  },
  "keywords": [
    "fashion",
    "ecommerce",
    "ai-stylist",
    "virtual-try-on",
    "catvton"
  ],
  "author": "SMARTBUY AI Team",
  "license": "MIT"
}
