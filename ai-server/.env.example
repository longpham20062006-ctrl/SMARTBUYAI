# Cấu hình AI Virtual Try-On Server - SMARTBUY AI
# RTX 3060 12GB VRAM Local Setup

TRYON_HOST=0.0.0.0
TRYON_PORT=8000
TRYON_DEBUG=false

# GPU & Mô hình
TRYON_DEVICE=cuda
TRYON_PRECISION=fp16
TRYON_MAX_VRAM_GB=11.5
TRYON_MODEL=CatVTON-FP16

# Giới hạn dung lượng và thời gian lưu trữ
MAX_UPLOAD_SIZE_MB=15
JOB_TIMEOUT_SECONDS=180
JOB_RETENTION_MINUTES=30
